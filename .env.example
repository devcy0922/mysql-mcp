# 이 파일은 키 목록과 비식별 예시만 제공한다.
# 복사본인 .env.mysql-mcp에만 실제 호스트·realm·계정·비밀번호를 기록한다.

# 개인 로컬 사용은 stdio, 원격 다중 사용자 서비스는 http를 선택한다.
MYSQL_MCP_TRANSPORT=stdio

# 데이터 생성 및 삭제(Create, Delete) 도구 활성화 여부 (true/false)
MYSQL_MCP_ENABLE_WRITE=false

# DB 연결 예시. example.invalid는 실제 통신에 사용할 수 없는 문서 전용 도메인이다.
MYSQL_MCP_DOMAINS_JSON='{
  "domains": [
    {
      "domain": "sample",
      "engine": "mysql",
      "host": "db.example.invalid",
      "port": 3306,
      "database": "sample_database",
      "user": "readonly_user",
      "passwordEnv": "MYSQL_MCP_SAMPLE_PASSWORD",
      "allowedTables": ["sample_view"],
      "requiredScopes": ["mysql:sample:read"],
      "ssl": {"rejectUnauthorized": true}
    }
  ]
}'
MYSQL_MCP_SAMPLE_PASSWORD=
MYSQL_MCP_DEFAULT_LIMIT=100
MYSQL_MCP_MAX_LIMIT=1000
MYSQL_MCP_CONNECTION_LIMIT=5
MYSQL_MCP_QUERY_TIMEOUT_MS=10000
MYSQL_MCP_AUDIT_LOG_PATH=/var/lib/mcp/logs/mysql-mcp-audit.jsonl

# 아래 항목은 MYSQL_MCP_TRANSPORT=http일 때만 필요하다.
# 외부 공개 URL은 TLS 종료 프록시를 포함해 클라이언트가 실제 접속하는 MCP URL이다.
MYSQL_MCP_HTTP_HOST=127.0.0.1
MYSQL_MCP_HTTP_PORT=3333
MYSQL_MCP_PUBLIC_URL=https://mcp.example.invalid/mcp

# Origin 헤더가 있는 요청은 이 목록과 정확히 일치해야 한다. 비워두면 Origin 없는 비브라우저 클라이언트만 허용한다.
MYSQL_MCP_HTTP_ALLOWED_ORIGINS=

# 기존 IAM의 OIDC issuer, 대상 audience, JWKS 주소를 배포 비밀로 주입한다.
MYSQL_MCP_OIDC_ISSUER=https://iam.example.invalid/realms/example
MYSQL_MCP_OIDC_AUDIENCE=https://mcp.example.invalid/mcp
MYSQL_MCP_OIDC_JWKS_URI=https://iam.example.invalid/realms/example/protocol/openid-connect/certs

# scope 이름은 IAM 정책과 일치시킨다.
MYSQL_MCP_OIDC_ACCESS_SCOPE=mysql:mcp
MYSQL_MCP_OIDC_METADATA_SCOPE=mysql:metadata
MYSQL_MCP_OIDC_READ_SCOPE=mysql:read
MYSQL_MCP_OIDC_WRITE_SCOPE=mysql:write
MYSQL_MCP_OIDC_USERNAME_CLAIM=preferred_username
